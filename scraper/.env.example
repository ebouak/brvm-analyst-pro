# ============================================================================
# BRVM Analyst Pro — Scraper BDFIN — variables d'environnement
# ----------------------------------------------------------------------------
# Copier ce fichier en .env.local (NON commité) et renseigner les valeurs.
# Ne JAMAIS commiter de secret. En production, utiliser les secrets
# Supabase / Vercel / GitHub Actions plutôt qu'un fichier.
# ============================================================================

# --- Source BDFIN BRVM ------------------------------------------------------
BDFIN_BASE_URL=https://bfin.brvm.org
BDFIN_LOGIN_PATH=/Default.aspx
BDFIN_MARKET_PATH=/Activites_marche.aspx

# Identifiants BDFIN. À stocker en secret, jamais en clair dans le repo.
BDFIN_USERNAME=
BDFIN_PASSWORD=

# --- Comportement réseau ----------------------------------------------------
# Timeout par requête (ms)
HTTP_TIMEOUT_MS=30000
# Nombre de tentatives sur erreur réseau / 5xx
HTTP_MAX_RETRIES=4
# Délai initial de backoff (ms), doublé à chaque tentative
HTTP_RETRY_BASE_MS=1000
# User-Agent envoyé au serveur ASP.NET
HTTP_USER_AGENT=BRVMAnalystPro-Scraper/0.1 (+contact@example.com)

# --- Supabase (persistance) -------------------------------------------------
# URL du projet Supabase
SUPABASE_URL=
# Clé service_role (côté serveur UNIQUEMENT — bypass RLS). Jamais exposée au frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Contrôle qualité -------------------------------------------------------
# Seuil de variation (%) au-delà duquel on lève une alerte data quality
QUALITY_MAX_ABS_VARIATION_PCT=30
# Si true, l'écriture est rejetée quand la validation échoue. Sinon, log seulement.
QUALITY_STRICT=false

# --- Divers -----------------------------------------------------------------
# Niveau de log pino: trace|debug|info|warn|error
LOG_LEVEL=info
# true => n'écrit pas en base, affiche seulement (dry run)
DRY_RUN=false
# true => utilise les fixtures mock au lieu d'appeler BDFIN
USE_MOCK=false
# Fuseau de référence du marché (Abidjan)
MARKET_TZ=Africa/Abidjan

# --- Notifications d'alertes (§6.8) -----------------------------------------
# Email via Resend (optionnel). Sans clé, fallback console.
RESEND_API_KEY=
ALERTS_EMAIL_FROM=alertes@example.com
# Telegram (optionnel). Sans token/chat, fallback console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
