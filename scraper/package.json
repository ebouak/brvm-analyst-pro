{
  "name": "brvm-analyst-pro-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Scraper BDFIN BRVM (ASP.NET WebForms) pour BRVM Analyst Pro — collecte actions, obligations, indices, événements.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "scrape:daily": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts daily",
    "scrape:daily:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts daily --mock",
    "scrape:date": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts date",
    "score": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts score",
    "backtest-signals": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts backtest-signals",
    "score:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts score --mock",
    "hebdo": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts hebdo",
    "hebdo:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts hebdo --mock",
    "liquidity": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts liquidity",
    "liquidity:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts liquidity --mock",
    "events": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts events",
    "events:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts events --mock",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "dividends": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts dividends",
    "dividends:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts dividends --mock",
    "intraday": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts intraday",
    "intraday:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts intraday --mock",
    "intraday:patterns": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts intraday:patterns",
    "intraday:patterns:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts intraday:patterns --mock",
    "veille": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts veille",
    "veille:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts veille --mock",
    "publications": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts publications",
    "publications:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts publications --mock",
    "shares": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts shares",
    "secteurs": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts secteurs",
    "cotations": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts cotations",
    "alerts": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts alerts",
    "alerts:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts alerts --mock",
    "these-alertes": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts these-alertes",
    "these-alertes:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts these-alertes --mock",
    "forum-trending": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts forum-trending",
    "forum-trending:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts forum-trending --mock",
    "backfill": "tsx src/index.ts backfill",
    "backfill:dry": "tsx src/index.ts backfill --dry-run",
    "validate": "tsx src/index.ts validate",
    "notations": "tsx src/index.ts notations",
    "notations:mock": "tsx src/index.ts notations --mock",
    "details": "tsx src/index.ts details",
    "details:mock": "tsx src/index.ts details --mock",
    "news": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts news",
    "brief": "tsx src/index.ts brief",
    "intraday:calibrate": "tsx src/index.ts intraday:calibrate",
    "brief:whatsapp": "tsx src/index.ts brief:whatsapp",
    "brief:whatsapp:mock": "tsx src/index.ts brief:whatsapp --mock",
    "monthly-reports": "tsx src/index.ts monthly-reports",
    "monthly-reports:test": "tsx src/index.ts monthly-reports --dry-run",
    "bdfin:instruments": "tsx src/index.ts bdfin:instruments",
    "bdfin:market": "tsx src/index.ts bdfin:market",
    "bdfin:market:date": "tsx src/index.ts bdfin:market:date",
    "daily:full": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts daily:full",
    "daily:full:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts daily:full --mock",
    "paper-trading:auto": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts paper-trading:auto",
    "paper-trading:auto:mock": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx src/index.ts paper-trading:auto --mock",
    "obscura:start": "obscura serve --port 9222 --stealth"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.7.7",
    "axios-cookiejar-support": "^5.0.3",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "msedge-tts": "^2.0.6",
    "pdfkit": "^0.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "puppeteer": "^23.5.0",
    "tough-cookie": "^5.0.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.12.11",
    "@types/puppeteer": "^5.4.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "obscura": "^1.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
