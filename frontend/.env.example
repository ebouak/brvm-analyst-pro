# Frontend — variables publiques (soumises à la RLS, clé anon uniquement).
# NE JAMAIS mettre la clé service_role ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (VAPID) — générer avec : npx web-push generate-vapid-keys
# La clé publique est exposée côté client (NEXT_PUBLIC_).
# La clé privée reste STRICTEMENT serveur (jamais NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# LLM pour diagnostic (déjà utilisé par Import IA — aucune nouvelle var requise)
# Les clés DeepSeek/Mistral/Grok sont lues via resolveApiKey() depuis Supabase ou env
