# Frontend — variables publiques (soumises à la RLS, clé anon uniquement).
# NE JAMAIS mettre la clé service_role ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (VAPID) — générer avec : npx web-push generate-vapid-keys
# La clé publique est exposée côté client (NEXT_PUBLIC_).
# La clé privée reste STRICTEMENT serveur (jamais NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# LLM pour diagnostic (déjà utilisé par Import IA — aucune nouvelle var requise)
# Les clés DeepSeek/Mistral/Grok sont lues via resolveApiKey() depuis Supabase ou env

# Encart de contact « Salut, on se parle ? » (non-intrusif, après engagement)
# Numéro WhatsApp au format international sans + (ex. 2250700000000).
# Si absent, le bouton WhatsApp est simplement masqué.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Lien d'invitation de la Chaîne WhatsApp WESTBOURSE (lot B). Absent : la ligne
# « Rejoignez la Chaîne » n'apparaît pas sous les réponses aux commandes.
WHATSAPP_CHAINE_URL=
# Même lien, côté navigateur : section vidéo de la landing (absent → lien masqué).
NEXT_PUBLIC_WHATSAPP_CHAINE_URL=
# Boîte de réception des messages de contact (défaut : ebouak@gmail.com).
# L'envoi passe par Resend (voir lib/server/email.ts).
CONTACT_EMAIL_TO=

# ── Crons Vercel (vercel.json) ──
# Secret protégeant les routes /api/cron/* (Vercel Cron l’injecte en
# Authorization: Bearer ; planifié dans vercel.json). Sans lui → 401.
CRON_SECRET=
# Canaux OPÉRATEUR (tous facultatifs ; un canal sans config est ignoré).
# Telegram : créer un bot via @BotFather, récupérer le chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp (Meta Cloud API). Le texte libre ne marche que dans la fenêtre 24 h ;
# pour du proactif hors fenêtre, prévoir un modèle (template) approuvé.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
# Agent conversationnel entrant (webhook Meta) — voir docs/WHATSAPP.md.
# APP_SECRET absent => le webhook rejette TOUT en 401 (fail-closed voulu).
WHATSAPP_APP_SECRET=
# Chaîne que vous inventez, à reporter à l'identique dans le dashboard Meta.
WHATSAPP_VERIFY_TOKEN=
# Email opérateur recevant le récap des bascules (via Resend).
ALERTS_OPS_EMAIL=

# Sentry — monitoring d'erreurs (actif uniquement en production).
# Le DSN n'est PAS un secret (émission d'événements seulement) → préfixe NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=https://a949ea7484241bd34fa31839b0797b9b@o4511593547300864.ingest.de.sentry.io/4511593560997968
# Upload des source maps (optionnel, en CI/Vercel) — sinon laissé vide.
# SENTRY_ORG, SENTRY_PROJECT : slugs de ton projet Sentry.
# SENTRY_AUTH_TOKEN : token avec scope project:releases (SECRET → Vercel uniquement).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Tavily API — recherche web en repli pour le détecteur de red flags
# Optionnel. Si absent, le système fonctionne sans recherche web (utilise la veille interne uniquement).
# Clé obtenue via https://tavily.com
TAVILY_API_KEY=

# ─── Paiement ────────────────────────────────────────────────────────────────
# Provider actif. `manual` (défaut) = intention + confirmation admin ; `cinetpay`
# = paiement en ligne Mobile Money (Orange, MTN, Moov, Wave) + carte.
# Une valeur inconnue retombe sur `manual` : une faute de frappe ne doit pas
# casser l'encaissement.
PAYMENT_PROVIDER=manual

# CinetPay — requis UNIQUEMENT si PAYMENT_PROVIDER=cinetpay.
# À récupérer dans le back-office CinetPay (Intégrations → API).
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Secret de signature du webhook (HMAC du header `x-token`).
# SANS LUI, LE WEBHOOK REFUSE TOUT : un webhook de paiement non authentifiable
# ouvrirait la caisse au premier venu (il suffirait de POSTer « payé »).
CINETPAY_SECRET_KEY=
# Le back-office CinetPay doit pointer notify_url vers :
#   https://www.westbourse.com/api/billing/webhook/cinetpay

# Chariow — niveaux de l'Academy à l'unité et pass premium (docs/CHARIOW_PAYMENTS.md).
# Coexiste avec PAYMENT_PROVIDER : il ne le remplace pas. SERVEUR UNIQUEMENT :
# aucune de ces variables ne doit porter le préfixe NEXT_PUBLIC_.
# Clé API (sk_test_… en test, sk_live_… en production) — tableau de bord Chariow.
CHARIOW_API_KEY=
# Secret de signature du Pulse (whsec_…) : Automations → Pulses → le Pulse →
# Overview → Signing secret. Ce n'est PAS la clé API. Sans lui, le webhook
# refuse tout (401).
CHARIOW_WEBHOOK_SECRET=
# Facultatif (défaut https://api.chariow.com/v1).
CHARIOW_API_BASE_URL=
# Base des URL de retour après paiement (défaut NEXT_PUBLIC_SITE_URL, puis
# https://www.westbourse.com). Publique par nature.
NEXT_PUBLIC_APP_URL=
# Le Pulse Chariow doit pointer vers :
#   https://www.westbourse.com/api/webhooks/chariow
# (événements : successful.sale, failed.sale, abandoned.sale, license.revoked)

# Cloudflare Turnstile (CAPTCHA login/signup) — clé de SITE (publique)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile — clé SECRÈTE (serveur uniquement, JAMAIS NEXT_PUBLIC_).
# Sur /login, c'est Supabase Auth qui valide le jeton (secret configuré dans le
# tableau de bord Supabase). Nos routes maison le valident elles-mêmes via
# lib/server/turnstile.ts — d'où ce secret ici.
# OBLIGATOIRE pour /api/api-access/request : sans lui, la route REFUSE tout
# (échec fermé — un captcha qui laisse passer quand il est mal configuré est un décor).
# À récupérer sur le tableau de bord Cloudflare Turnstile, en face de la clé de site.
TURNSTILE_SECRET_KEY=

# Dossier valeur (rapport A4 par action)
# Secret présenté en en-tête x-dossier-render par video/dossiers.mjs pour
# imprimer la page sans session. ≥ 32 caractères, même valeur sur Vercel et
# dans les secrets GitHub. Jamais dans une URL.
DOSSIER_RENDER_SECRET=

# Appels vocaux Bland (migration 0250) — serveur uniquement, jamais NEXT_PUBLIC_.
# Sans BLAND_API_KEY, aucun appel ne part (le bouton de la console le dit).
BLAND_API_KEY=
# Secret d'empreinte HMAC des numéros (≥ 32 caractères). Le changer rend
# illisibles les oppositions déjà enregistrées : ne pas le faire tourner.
BLAND_HASH_SECRET=
# Numéro de l'exploitant, E.164 : transfert vers un humain et alertes vocales.
# JAMAIS dans le code ni un test.
BLAND_NUMERO_EXPLOITANT=
# Secret de POST /api/voix/alerte (Bearer, ≥ 32 caractères), même valeur que le
# secret GitHub VOIX_ALERTE_SECRET.
VOIX_ALERTE_SECRET=
# Plafond d'appels par jour, tous motifs (défaut 10).
VOIX_MAX_JOUR=10

# ── Orchestrateur Admin Ops via Telegram (migration 0274) ──────────────────
# Bot Telegram dédié exclusivement à l'administration (distinct du bot client).
TELEGRAM_OPS_BOT_TOKEN=
# Jeton secret fourni à setWebhook (header X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_OPS_WEBHOOK_SECRET=
# Liste blanche des chat_id admin (entiers séparés par virgules). Si vide, repli
# sur TELEGRAM_CHAT_ID + table ops_settings.admin_telegram_chat_ids.
TELEGRAM_OPS_ADMIN_CHAT_IDS=
# PAT GitHub finement scopé (Actions: Read & Write) pour /relancer et /admin/ops.
GITHUB_OPS_TOKEN=
# Dépôt cible (défaut : ebouak/brvm-analyst-pro).
GITHUB_OPS_REPO=
# Secret partagé pour POST /api/ops/callback (>= 32 caractères).
OPS_CALLBACK_SECRET=
# Secret HMAC pour l'image PNG /pulse (>= 32 car. ; sinon repli sur RECAP_SECRET).
OPS_PULSE_SECRET=
# Transcription notes vocales Telegram Ops (cascade Groq -> OpenAI -> Gemini).
GROQ_API_KEY=
OPENAI_API_KEY=
